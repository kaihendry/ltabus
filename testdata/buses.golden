<!DOCTYPE html>
<html lang=en>

<head>
	<meta charset=utf-8>
	<meta name=viewport content="width=device-width, initial-scale=1">
	<link rel="stylesheet" href="/static/main.css">
	<link rel="manifest" href="/static/manifest.json">
	<script src="/static/main.js" defer></script>
	
	<meta http-equiv="refresh" content="20">
	<meta name="robots" content="noindex">
	<title>Singapore bus arrival times for stop 99999</title>
	<meta name="apple-mobile-web-app-title" content="Test Bus Stop">
	<link rel='icon' href='/icon?stop=99999'>
	<link rel="apple-touch-icon" sizes="200x200" href="/icon?stop=99999">
	<meta name="description" content="Bus arrival times for 99999 Test Bus Stop" />
	<meta property="og:title" content="Bus 99999 Test Bus Stop" />
	<meta property="og:description" content="Live bus arrival times for stop 99999" />
	<meta property="og:url" content="https://bus.dabase.com/?id=99999" />
	<meta property="og:image" content="https://bus.dabase.com/icon?stop=99999" />
	
</head>

<body>

	<h1><a style="text-decoration: none;" href="/">🚏</a>
		
		<span style="background-color: #d3eb9a; padding: 0.2em" id="namedBusStop">Test Bus Stop</span>
		
	</h1>

	<form>
		<label for=id>Bus stop #</label>
		<input autofocus id=id required type=text inputmode="numeric" pattern="\d{5}" value="99999"
			name=id>
		<input value="Bus due times" type=submit>
	</form>

	<ul class=buses>
		
		<li>
			<strong>
				<a href='https://busrouter.sg/#/services/42'>42</a>
			</strong>

			<time class="load-seats" dateTime="2026-08-24T21:01:30&#43;08:00">2026-08-24T21:01:30&#43;08:00</time>
			
			

		</li>
		
		<li>
			<strong>
				<a href='https://busrouter.sg/#/services/666'>666</a>
			</strong>

			<time class="load-standing" dateTime="2026-08-24T21:05:30&#43;08:00">2026-08-24T21:05:30&#43;08:00</time>
			<time class="load-full" dateTime="2026-08-24T21:17:30&#43;08:00">2026-08-24T21:17:30&#43;08:00</time>
			<time class="load-seats" dateTime="2026-08-24T21:32:30&#43;08:00">2026-08-24T21:32:30&#43;08:00</time>

		</li>
		
	</ul>

	

	<h4>Last updated: <span id=lastupdated></span></h4>

	<ol id=stations></ol>

	<footer>
		<ul>
			<li><a href=https://github.com/kaihendry/ltabus>Source code</a></li>
			<li><a href="mailto:hendry+bus@iki.fi">Please email feedback</a></li>
			<li><a href=https://railrouter.sg>Train map</a></li>
			<li>There are 5208 bus stops in Singapore</li>
		</ul>
	</footer>

	<p><button>Share this Web app!</button></p>

	<p class="result"></p>

	<script>
		let shareData = {
			title: '🇸🇬 Bus arrival times',
			text: 'Bus arrivals times, hit 🚏 to find closest bus stop',
			url: 'https://bus.dabase.com',
		}

		const btn = document.querySelector('button');
		const resultPara = document.querySelector('.result');

		btn.addEventListener('click', () => {
			navigator.share(shareData)
				.then(() =>
					resultPara.textContent = 'Shared successfully'
				)
				.catch((e) =>
					resultPara.textContent = 'Error: ' + e
				)
		});
	</script>


</body>

</html>
