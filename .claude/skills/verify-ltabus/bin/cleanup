#!/usr/bin/env bash
# Stop the server this RUN started and delete its binary. Evidence stays in RUN.
set -euo pipefail
run=${1:?usage: cleanup <run dir>}
run=$(cd "$run" && pwd)

if [ -f "$run/pid" ]; then
	pid=$(cat "$run/pid")
	# Only kill the process if it is still the binary this run built.
	if [ "$(ps -o command= -p "$pid" 2>/dev/null)" = "$run/ltabus" ]; then
		kill "$pid"
		for _ in $(seq 25); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
		kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
		echo "stopped $pid"
	fi
	rm -f "$run/pid"
fi
rm -f "$run/ltabus"
echo "evidence kept in $run"
